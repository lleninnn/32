# auth.py
# Регистрация и вход пользователей с хешированием паролей (bcrypt).

import bcrypt
from database import save_user, get_user

def register(username, password):
    """
    Регистрирует нового пользователя.
    Проверяет длину имени (не менее 3) и пароля (не менее 6).
    Хеширует пароль с помощью bcrypt и сохраняет в БД.
    Возвращает (успех, сообщение).
    """
    if len(username) < 3 or len(password) < 6:
        return False, 'Имя пользователя должно быть не менее 3 символов, а пароль - не менее 6.'

    # Проверка, существует ли уже пользователь с таким именем
    user = get_user(username)
    if user:
        return False, 'Пользователь уже существует.'

    # Хеширование пароля: генерируем соль, хешируем, декодируем в строку
    hashed = bcrypt.hashpw(password.encode('utf-8'), bcrypt.gensalt()).decode('utf-8')

    # Сохранение в базу данных
    success, msg = save_user(username, hashed)
    return success, msg

def login(username, password):
    """
    Аутентифицирует пользователя.
    Ищет пользователя по имени, сравнивает хеш введённого пароля с сохранённым.
    Возвращает (успех, сообщение, имя_пользователя) – имя возвращается для удобства.
    """
    user = get_user(username)
    if not user:
        return False, 'Пользователь не найден.', None

    stored_hash = user[1].encode('utf-8')        # второй столбец – хеш пароля
    if bcrypt.checkpw(password.encode('utf-8'), stored_hash):
        return True, 'Вход успешен.', username
    else:
        return False, 'Неверный пароль.', None
