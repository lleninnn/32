# ТЕСТЫ ДЛЯ ПРОВЕРКИ АЛГОРИТМА
def test_all():
    print("Запуск тестов...")

    # ТЕСТ 1: Парсинг строки с названием из нескольких слов
    test_line = "Нижний Новгород 56.3269 44.0059"
    parts = test_line.strip().split()
    *name_parts, x_str, y_str = parts
    name = ' '.join(name_parts)
    x, y = float(x_str), float(y_str)
    assert name == "Нижний Новгород", "Ошибка в названии"
    assert abs(x - 56.3269) < 1e-6, "Ошибка в координате x"
    assert abs(y - 44.0059) < 1e-6, "Ошибка в координате y"
    print("✓ Тест парсинга пройден")

    # ТЕСТ 2: Присвоение кластера
    point = [0, 0]
    centers = [[1, 0], [5, 5]]
    dist = [math.hypot(point[0] - cx, point[1] - cy) for cx, cy in centers]
    cluster = dist.index(min(dist))
    assert cluster == 0, "Точка (0,0) должна быть ближе к центру (1,0)"
    print("✓ Тест присвоения кластера пройден")

    # ТЕСТ 3: Пересчёт центра кластера 
    cluster_points = [[0, 0], [2, 0], [1, 2]]
    avg_x = sum(p[0] for p in cluster_points) / len(cluster_points)
    avg_y = sum(p[1] for p in cluster_points) / len(cluster_points)
    assert math.isclose(avg_x, 1.0, rel_tol=1e-6), "Среднее по X должно быть 1.0"
    assert math.isclose(avg_y, 2/3, rel_tol=1e-6), "Среднее по Y должно быть 0.666..."
    print("✓ Тест пересчёта центра пройден")

    # ТЕСТ 4: Пустой кластер
    # Создадим три города и три центра, но второй и третий центры далеко
    test_cities = [[0,0,"A"], [1,0,"B"], [0,1,"C"]]
    test_centers = [[0,0], [100,100], [200,200]]
    K_test = 3
    # "Распределим" города (все попадут в кластер 0)
    for city in test_cities:
        dist = [math.hypot(city[0]-cx, city[1]-cy) for cx,cy in test_centers]
        city.append(dist.index(min(dist)))   # добавляем номер кластера
    # Пересчитаем центры
    new_centers = []
    for i in range(K_test):
        pts = [c for c in test_cities if c[3] == i]
        if pts:
            avg_x = sum(p[0] for p in pts) / len(pts)
            avg_y = sum(p[1] for p in pts) / len(pts)
            new_centers.append([avg_x, avg_y])
        else:
            new_centers.append(test_centers[i])   # для пустых оставляем старый
    # Проверяем: центр 0 пересчитан (примерно 0.33, 0.33), центры 1 и 2 не изменились
    assert math.isclose(new_centers[0][0], 0.333, rel_tol=0.01), "Центр 0 должен обновиться"
    assert new_centers[1] == [100,100], "Центр 1 не должен измениться"
    assert new_centers[2] == [200,200], "Центр 2 не должен измениться"
    print("✓ Тест пустого кластера пройден")

    # ТЕСТ 5: Полный цикл на двух кластерах
    # Подготовим данные: два хорошо разделённых кластера
    data = [
        [0, 0, "P1"],
        [1, 0, "P2"],
        [0, 1, "P3"],
        [10, 10, "Q1"],
        [11, 10, "Q2"],
        [10, 11, "Q3"]
    ]
    # Копируем данные, чтобы не испортить
    test_cities = [row[:] for row in data]  # [x, y, name]
    K_test = 2
    # Фиксируем random seed для воспроизводимости
    random.seed(42)
    # Выбираем начальные центры (случайные города из данных)
    centers_test = [test_cities[i][:2] for i in random.sample(range(len(test_cities)), K_test)]

    # Несколько итераций (достаточно 3)
    for _ in range(3):
        # Распределение
        for city in test_cities:
            dist = [math.hypot(city[0]-cx, city[1]-cy) for cx,cy in centers_test]
            cluster = dist.index(min(dist))
            if len(city) == 3:
                city.append(cluster)
            else:
                city[3] = cluster
        # Пересчёт центров
        new_centers = []
        for i in range(K_test):
            pts = [c for c in test_cities if c[3] == i]
            if pts:
                avg_x = sum(p[0] for p in pts) / len(pts)
                avg_y = sum(p[1] for p in pts) / len(pts)
                new_centers.append([avg_x, avg_y])
            else:
                new_centers.append(centers_test[i])
        centers_test = new_centers

    # Проверяем, что точки разбились правильно
    clusters = [c[3] for c in test_cities]
    # Первые три должны быть в одном кластере, последние три – в другом
    assert clusters[0] == clusters[1] == clusters[2], "Первые три точки должны быть в одном кластере"
    assert clusters[3] == clusters[4] == clusters[5], "Последние три точки должны быть в одном кластере"
    assert clusters[0] != clusters[3], "Кластеры должны быть разными"
    print("✓ Тест полного цикла пройден")

    print("Все тесты успешно пройдены!")

