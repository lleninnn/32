import random
import math
import matplotlib.pyplot as plt
import tracemalloc
from datetime import datetime

# ---------- ФУНКЦИЯ K-СРЕДНИХ ----------
def kmeans(cities, K, max_iter=100, eps=1e-6, seed=None):
    """
    Выполняет кластеризацию методом K-средних.
    cities: список городов в формате [x, y, name]
    K: число кластеров
    max_iter: максимальное число итераций
    eps: порог сходимости
    seed: если задан, фиксирует генератор случайных чисел
    Возвращает:
        labels: список номеров кластеров для каждого города
        centers: список центров кластеров
        inertia: сумма квадратов расстояний до центров
    """
    if seed is not None:
        random.seed(seed)
    # Копия, чтобы не портить исходные данные
    data = [row[:] for row in cities]  # каждый город: [x, y, name]
    n = len(data)
    # Инициализация центров случайными городами
    centers = [data[i][:2] for i in random.sample(range(n), K)]

    for _ in range(max_iter):
        old_centers = [c[:] for c in centers]
        # Распределение по кластерам
        for city in data:
            dist = [math.hypot(city[0] - cx, city[1] - cy) for cx, cy in centers]
            cluster = dist.index(min(dist))
            if len(city) == 3:
                city.append(cluster)
            else:
                city[3] = cluster
        # Пересчёт центров
        new_centers = []
        for i in range(K):
            pts = [c for c in data if c[3] == i] # генератор списков - берём из data все города i, у которых есть 4 элемент списка
            if pts:
                avg_x = sum(p[0] for p in pts) / len(pts)
                avg_y = sum(p[1] for p in pts) / len(pts)
                new_centers.append([avg_x, avg_y])
            else:
                new_centers.append(centers[i]) # оставляем тот же центр, если кластер пуст
        # Проверка сходимости
        move = sum(math.hypot(nc[0]-oc[0], nc[1]-oc[1]) for nc, oc in zip(new_centers, old_centers)) # суммарное перемещение всех центров (zip создаёт пары)
        centers = new_centers
        if move < eps:
            break

    # Сбор меток и вычисление инерции
    labels = [city[3] for city in data] # извлекаем 4 элемент
    inertia = 0.0 # вычисляем инерцию - сумма квадратов расстояний от каждого города до его центров
    for i, city in enumerate(data): # из списка - в последовательность(где индекс, значение)
        cx, cy = centers[labels[i]]
        dx = city[0] - cx
        dy = city[1] - cy
        inertia += dx*dx + dy*dy
    return labels, centers, inertia

# ЧТЕНИЕ ДАННЫХ
cities = []
with open("city.txt", 'r', encoding='utf-8') as file:
    for line in file:
        line = line.strip()
        if not line or len(line) < 3:
            continue
        parts = line.split()
        *name_cities, x, y = parts
        cities.append([float(x), float(y), ' '.join(name_cities)])

if not cities:
    print("Файл пуст")
    exit()

# МЕТОД ЛОКТЯ
ans = input("Хотите определить оптимальное K методом локтя? (y/n): ").strip().lower()
if ans == 'y':
    # Определяем диапазон K (не больше числа городов)
    max_K = min(10, len(cities))
    K_range = range(1, max_K + 1)
    inertias = []
    print("Вычисление инерции для K от 1 до", max_K)
    for K in K_range:
        # Фиксируем seed для воспроизводимости
        _, _, inertia = kmeans(cities, K, seed=42)
        inertias.append(inertia)
        print(f"K={K}, инерция={inertia:.2f}")

    # Построение графика
    plt.figure(figsize=(8, 5))
    plt.plot(K_range, inertias, 'bo-')
    plt.xlabel('Количество кластеров K')
    plt.ylabel('Сумма квадратов расстояний (инерция)')
    plt.title('Метод локтя для выбора K')
    plt.grid(True)
    plt.show()

    # Запрос выбранного K
    K = int(input("Введите выбранное K по графику: "))
else:
    K = int(input("Введите кол-во кластеров: "))

# Проверка допустимости K
if K < 1 or K > len(cities):
    print("K должно быть от 1 до", len(cities))
    exit()

# Измерение времени и памяти для финальной кластеризации
tracemalloc.start()
start_time = datetime.now()

# КЛАСТЕРИЗАЦИЯ С ВЫБРАННЫМ K
labels, centers, _ = kmeans(cities, K, seed=42)  # фиксируем seed для повторяемости

# Окончание измерение метрик
end_time = datetime.now()
current_mem, peak_mem = tracemalloc.get_traced_memory()
tracemalloc.stop()

# Вывод результатов
clusters = {}
for i, label in enumerate(labels): # из последовательности в индекс-значение
    clusters.setdefault(label, []).append(cities[i][2]) # извлекаем значение по указанному ключу, если он существует, а если ключа нет, вставляем ключ с указанным значением по умолчанию

print("\nРезультаты кластеризации:")
for label, names in sorted(clusters.items()): # сортируем кластеры по метке в порядке возрастания
    print(f"Кластер {label+1}: {', '.join(names)}")

# Вывод соответствующих метрик
print(f"\nВремя выполнения финальной кластеризации: {(end_time - start_time).total_seconds():.6f} сек")
print(f"Пиковое использование памяти: {peak_mem / 1024:.2f} КБ")
