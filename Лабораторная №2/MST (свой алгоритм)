import math
from datetime import datetime
import tracemalloc

# Чтение данных из файла
# cities будет списком словарей, каждый словарь содержит название города и его координаты
cities = []
with open("city.txt", 'r', encoding='utf-8') as f: # закрытие файла после выхода из блока
    for line in f:
        line = line.strip()                # удаляем лишние пробелы и символы перевода строки
        if not line:                        # пропускаем пустые строки
            continue
        parts = line.split()                # разбиваем строку по пробелам
        # последние две части — координаты, всё остальное — название (может содержать пробелы)
        *name_parts, x_str, y_str = parts
        name = ' '.join(name_parts)         # собираем название обратно в строку
        # добавляем город в список как словарь
        cities.append({
            'name': name,
            'x': float(x_str),
            'y': float(y_str)
        })

n = len(cities)# количество городов
if n == 0:
    print("Файл пуст")
    exit()

K = int(input("Введите количество кластеров K: "))
if K < 1 or K > n:
    print("K должно быть от 1 до", n)
    exit()

# Измерение времени и памяти
tracemalloc.start()
start_time = datetime.now()

# СИСТЕМА НЕПЕРЕСЕКАЮЩИХСЯ МНОЖЕСТВ (DSU)
# каждому городу соответствует индекс от 0 до n-1.
parent = list(range(n))   # parent[i] — "родитель" элемента i (изначально каждый сам себе родитель, он же корень)
rank = [0] * n            # rank[i] — ранг (глубина дерева) для балансировки при объединении

def find(v):
    """Возвращает корень множества, содержащего элемент v, с применением сжатия путей."""
    while parent[v] != v:
        # Переподвешиваем текущий элемент к его "дедушке" — это сжатие путей
        parent[v] = parent[parent[v]]
        v = parent[v]
    return v

def union(v1, v2):
    """Объединяет множества, содержащие элементы v1 и v2. Возвращает True, если объединение произошло."""
    r1, r2 = find(v1), find(v2)
    if r1 == r2:
        return False                # элементы уже в одном множестве
    # Объединение по рангу: подвешиваем дерево меньшего ранга к корню большего ранга
    if rank[r1] < rank[r2]:
        parent[r1] = r2
    elif rank[r1] > rank[r2]:
        parent[r2] = r1
    else:
        # Если ранги равны, подвешиваем к r1 и увеличиваем его ранг
        parent[r2] = r1
        rank[r1] += 1
    return True

# ПОСТРОЕНИЕ СПИСКА ВСЕХ РЁБЕР
# ребро — это кортеж (вес, индекс_города_1, индекс_города_2)
edges = []
for i in range(n):
    for j in range(i+1, n):          # перебираем все пары (i < j), чтобы не дублировать рёбра
        dx = cities[i]['x'] - cities[j]['x']
        dy = cities[i]['y'] - cities[j]['y']
        w = math.hypot(dx, dy)       # евклидово расстояние между городами i и j
        edges.append((w, i, j))

# Сортируем рёбра по возрастанию веса (от самого короткого к самому длинному)
edges.sort(key=lambda x: x[0])

# ОБЪЕДИНЯЕМ ГОРОДА, ПОКА НЕ ОСТАНЕТСЯ K КОМПОНЕНТ
# изначально каждый город находится в своей компоненте, поэтому компонент = n
components = n

# если K равно числу городов, ничего объединять не нужно — сразу переходим к сбору результатов.
if K < n:
    for w, i, j in edges:
        # пытаемся объединить множества, содержащие i и j
        if union(i, j):
            components -= 1           # успешное объединение уменьшает количество компонент
            if components == K:
                break                  # достигли нужного числа кластеров — можно остановиться

# СБОР КЛАСТЕРОВ
# проходим по всем городам, находим корень его множества и группируем названия по корням.
clusters = {}
for i in range(n):
    root = find(i)                     # финальный корень для всех городов i
    # добавляем название города в список, соответствующий данному корню
    clusters.setdefault(root, []).append(cities[i]['name']) # извлекаем значение по указанному ключу, если он существует, а если ключа нет, вставляем ключ с указанным значением по умолчанию

# Окончание измерений
end_time = datetime.now()
current_mem, peak_mem = tracemalloc.get_traced_memory()
tracemalloc.stop()

# ВЫВОД РЕЗУЛЬТАТОВ
print("\nКластеры (метод MST + Краскал):")
for idx, (root, names) in enumerate(clusters.items()):
    print(f"Кластер {idx+1}: {', '.join(names)}")

# Вывод соответствующих метрик
print(f"\nВремя выполнения: {(end_time - start_time).total_seconds():.6f} сек")
print(f"Пиковое использование памяти: {peak_mem / 1024:.2f} КБ")
